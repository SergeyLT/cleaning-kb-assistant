APP_ENVIRONMENT=local
APP_VERSION=0.1.0
HOST_PORT=8001
APP_BASE_URL=http://127.0.0.1:8001
DATABASE_PATH=output/cleaning-kb.sqlite3
ADMIN_USERNAME=manager
# Создайте .env командой python -m cleaning_kb init-env: заглушки не принимаются.
ADMIN_PASSWORD_HASH=
API_KEY=
SESSION_TTL_SECONDS=28800
LOGIN_ATTEMPTS_PER_MINUTE=10
MAX_REQUEST_BYTES=1048576
QDRANT_URL=http://127.0.0.1:6333
DEPENDENCY_TIMEOUT_SECONDS=2
PROXYAPI_KEY=
PROXYAPI_BASE_URL=https://api.proxyapi.ru/v1
GENERATION_MODEL=openai/gpt-4.1-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSION=1536
PROVIDER_TIMEOUT_SECONDS=45
PROVIDER_CALLS_PER_MINUTE=20
PROVIDER_CALLS_PER_DAY=200
PROVIDER_TOKEN_BUDGET_PER_DAY=500000
MAX_ANSWER_TOKENS=1600
MAX_DOCUMENT_CHARS=30000
MAX_CONTEXT_CHARS=14000
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.2
CONFIDENCE_THRESHOLD=0.7
DIALOG_MAX_TOKENS=16000
SUMMARY_MAX_TOKENS=2400
# Необязательный ключ уже защищённого Qdrant (не требуется для закрытой Compose-сети).
QDRANT_API_KEY=
